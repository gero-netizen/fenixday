# FênixDay — Variáveis de Ambiente
# ⚠  NUNCA commitar este arquivo no Git!
# Adicionar .env ao .gitignore imediatamente.
# Gerar SECRET_KEY com: openssl rand -hex 32

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=GERAR_COM_openssl_rand_-hex_32
PREVIOUS_SECRET_KEY=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fenixday
POSTGRES_USER=fenixday
POSTGRES_PASSWORD=TROCAR_POR_SENHA_FORTE

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TROCAR_POR_SENHA_FORTE

# ── BTCPay Server ─────────────────────────────────────────────────────────────
BTCPAY_SERVER_URL=https://pay.seudominio.com
BTCPAY_API_KEY=SEU_API_KEY_BTCPAY
BTCPAY_STORE_ID=SEU_STORE_ID_BTCPAY
BTCPAY_WEBHOOK_SECRET=SEU_WEBHOOK_SECRET_BTCPAY

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ZONE_ID=SEU_ZONE_ID
CLOUDFLARE_API_TOKEN=SEU_API_TOKEN

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=2.0.0
CORS_ORIGINS=https://seudominio.com,https://app.seudominio.com
