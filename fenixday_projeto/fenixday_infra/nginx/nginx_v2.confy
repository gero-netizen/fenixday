events {
    worker_connections 1024;
}

http {
    server {
        listen 80;
        server_name fenixday.info www.fenixday.info;
        return 301 https://$host$request_uri;
    }

    server {
        listen 443 ssl;
        server_name fenixday.info www.fenixday.info;

        ssl_certificate     /etc/letsencrypt/live/fenixday.info/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/fenixday.info/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;

        location /api/ {
            proxy_pass http://fenix_api:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
        }

        location /health {
            proxy_pass http://fenix_api:8000/health;
        }

        location /terms {
            alias /etc/nginx/static/terms.html;
            default_type text/html;
        }

        location /privacy {
            alias /etc/nginx/static/privacy.html;
            default_type text/html;
        }

        location / {
            return 200 'FênixDay v2.0 online!';
            add_header Content-Type text/plain;
        }
    }
}
